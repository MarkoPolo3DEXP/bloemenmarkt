<?xml version="1.0" encoding="UTF-8"?>
<tracker id="T2" parent_id="0" instantiate_for_new_projects="0">
  <name><![CDATA[Feature]]></name>
  <item_name>feature</item_name>
  <description><![CDATA[Feature catalog: the shared, domain-engineering vocabulary that Requirement, Design, Test Case and Document artifacts are tagged against. Parent/child tree is built using the reserved "Child" artifact link type on the Links field. Cross-tree requires/excludes constraints use the requires_feature/excludes_feature link natures (set up separately under project-wide Artifact link types).]]></description>
  <color>deep-blue</color>
  <cannedResponses/>
  <formElements>
    <formElement type="aid" ID="F1" rank="0">
      <name>id</name>
      <label><![CDATA[Id]]></label>
    </formElement>
    <formElement type="subby" ID="F2" rank="1">
      <name>submitted_by</name>
      <label><![CDATA[Submitted by]]></label>
    </formElement>
    <formElement type="subon" ID="F3" rank="2">
      <name>submitted_on</name>
      <label><![CDATA[Submitted on]]></label>
    </formElement>
    <formElement type="lud" ID="F4" rank="3">
      <name>last_update_date</name>
      <label><![CDATA[Last modified on]]></label>
    </formElement>
    <formElement type="string" ID="F5" rank="4">
      <name>feature_name</name>
      <label><![CDATA[Feature name]]></label>
      <properties size="40"/>
    </formElement>
    <formElement type="sb" ID="F6" rank="5">
      <name>feature_type</name>
      <label><![CDATA[Feature type]]></label>
      <bind type="static" is_rank_alpha="0">
        <items>
          <item ID="V1" label="Mandatory" is_hidden="0"/>
          <item ID="V2" label="Optional" is_hidden="0"/>
          <item ID="V3" label="Alternative" is_hidden="0"/>
          <item ID="V4" label="Or" is_hidden="0"/>
        </items>
      </bind>
    </formElement>
    <formElement type="string" ID="F7" rank="6">
      <name>feature_group_id</name>
      <label><![CDATA[Group ID]]></label>
      <description><![CDATA[Tags which sibling choice-group this feature belongs to, when a parent feature has more than one Alternative or Or group among its children. Leave blank for Mandatory/Optional features, or when a parent has only a single choice-group.]]></description>
      <properties size="20"/>
    </formElement>
    <formElement type="text" ID="F8" rank="7">
      <name>description</name>
      <label><![CDATA[Description]]></label>
      <properties rows="10" cols="60"/>
    </formElement>
    <formElement type="sb" ID="F9" rank="8">
      <name>status</name>
      <label><![CDATA[Status]]></label>
      <bind type="static" is_rank_alpha="0">
        <items>
          <item ID="V5" label="Proposed" is_hidden="0"/>
          <item ID="V6" label="Active" is_hidden="0"/>
          <item ID="V7" label="Deprecated" is_hidden="0"/>
        </items>
      </bind>
    </formElement>
    <formElement type="art_link" ID="F10" rank="9">
      <name>art_link</name>
      <label><![CDATA[Links]]></label>
    </formElement>
  </formElements>
  <semantics>
