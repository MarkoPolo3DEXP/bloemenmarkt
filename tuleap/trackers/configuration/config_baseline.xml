    </formElement>
    <formElement type="string" ID="F8" rank="7">
      <name>version_label</name>
      <label><![CDATA[Version label]]></label>
      <description><![CDATA[This baseline's own release/version identifier on the evolution axis for this Product, e.g. "1.0". Distinct from the version_label field on individual Requirement/Design/Test Case/Document artifacts - this one identifies the baseline itself, not any single pinned artifact.]]></description>
      <properties size="20"/>
    </formElement>
    <formElement type="date" ID="F9" rank="8">
      <name>baseline_date</name>
      <label><![CDATA[Baseline date]]></label>
      <description><![CDATA[When this baseline was (or will be) frozen.]]></description>
    </formElement>
    <formElement type="sb" ID="F10" rank="9">
