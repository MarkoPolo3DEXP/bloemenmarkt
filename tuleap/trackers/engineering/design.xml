<tracker id="T6" parent_id="0" instantiate_for_new_projects="0">
  <name><![CDATA[Design]]></name>
  <item_name>design</item_name>
  <description><![CDATA[Engineering Artifact tracker. Same immutable-version-node pattern as Requirement: never edit an artifact once another has linked back to it as a parent - create a new artifact and link it instead. logical_id stays identical across every version/branch of "the same" design element; branch is a free-text label naming which line of evolution this node sits on; version_label is a manually-maintained sequence label (see field description) reset whenever branch differs from the parent's. Links to this version's parent(s) (one = normal evolution, more than one = a branch merge), and to the Requirement artifact(s) this design satisfies. Will later be pinned into Baseline Item snapshots alongside the Requirement, Test Case and Document versions it belongs with.]]></description>
  <color>sherwood-green</color>
  <cannedResponses/>
  <formElements>
    <formElement type="aid" ID="F1" rank="0">
      <name>id</name>
      <label><![CDATA[Id]]></label>
    </formElement>
    <formElement type="subby" ID="F2" rank="1">
      <name>submitted_by</name>
      <label><![CDATA[Submitted by]]></label>
