      <label><![CDATA[Last modified on]]></label>
    </formElement>
    <formElement type="string" ID="F5" rank="4">
      <name>design_title</name>
      <label><![CDATA[Design title]]></label>
      <properties size="60"/>
    </formElement>
    <formElement type="string" ID="F6" rank="5">
      <name>logical_id</name>
      <label><![CDATA[Logical ID]]></label>
      <description><![CDATA[Stable identifier shared by every version/branch of "the same" design element, e.g. DES-BRK-003. Never changes across versions.]]></description>
      <properties size="20"/>
    </formElement>
    <formElement type="string" ID="F7" rank="6">
      <name>branch</name>
      <label><![CDATA[Branch]]></label>
      <description><![CDATA[Free-text label naming which line of evolution this version node sits on, e.g. main, UEV-branch. Not a predefined list, since branches are created ad hoc.]]></description>
      <properties size="30"/>
    </formElement>
    <formElement type="string" ID="F11" rank="7">
      <name>version_label</name>
      <label><![CDATA[Version label]]></label>
      <description><![CDATA[Sequence label within this branch, in whatever convention your team uses - plain increments ("1", "2", "3"), a padded pattern ("PN006", "PN007"), or anything else. First node on a branch gets the starting label of that convention; each following node on the SAME branch, whose parent is the previous label, gets the next one; reset to the starting label whenever a node's branch differs from its parent's (i.e. a fork). Filled in manually for now. Note: this is a text field, so it sorts alphabetically in reports, not numerically - zero-pad (v01, v02, ...) if you need correct ordering past single digits.]]></description>
      <properties size="20"/>
    </formElement>
    <formElement type="sb" ID="F8" rank="8">
      <name>status</name>
      <label><![CDATA[Status]]></label>
      <bind type="static" is_rank_alpha="0">
        <items>
          <item ID="V1" label="Draft" is_hidden="0"/>
          <item ID="V2" label="In review" is_hidden="0"/>
          <item ID="V3" label="Approved" is_hidden="0"/>
          <item ID="V4" label="Obsolete" is_hidden="0"/>
        </items>
      </bind>
    </formElement>
    <formElement type="text" ID="F9" rank="9">
      <name>description</name>
      <label><![CDATA[Description]]></label>
      <properties rows="15" cols="60"/>
    </formElement>
    <formElement type="art_link" ID="F10" rank="10">
      <name>art_link</name>
      <label><![CDATA[Links]]></label>
      <description><![CDATA[Link to this version's parent(s), and to the Requirement artifact(s) this design satisfies.]]></description>
    </formElement>
  </formElements>
